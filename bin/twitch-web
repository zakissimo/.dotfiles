<script>
const $ = s => document.querySelector(s);
let sock = null, current = null, currentStream = null, hls = null, EMOTES = {}, esock = null;

function uptime(iso){
  if(!iso) return '';
  const m = Math.floor((Date.now() - new Date(iso)) / 60000);
  return (m >= 60 ? Math.floor(m/60)+'h '+(m%60)+'m' : m+'m');
}

async function loadLive(){
  const list = $('#list');
  const r = await fetch('/api/live').then(r => r.json()).catch(e => ({error:String(e)}));
  if(r.error){ list.innerHTML = ''; list.title = r.error; return; }
  list.innerHTML = '';

  const add = (s, cls) => {
    const el = document.createElement('div');
    el.className = 'av ' + cls + (s.login === current ? ' on' : '');
    el.dataset.login = s.login;
    // no labels in the rail, so the tooltip carries everything
    el.title = s.name + '\n' + (s.game || '-') + ' - ' + s.viewers.toLocaleString()
             + ' viewers - ' + uptime(s.started_at) + (s.title ? '\n' + s.title : '');
    const img = document.createElement('img');
    img.src = s.avatar || ''; img.alt = s.name; img.loading = 'lazy';
    el.appendChild(img);
    el.onclick = () => watch(s);
    list.appendChild(el);
  };

  (r.streams || []).forEach(s => add(s, 'fl'));
  if((r.suggested || []).length){
    const sep = document.createElement('div');
    sep.className = 'sep';
    list.appendChild(sep);
    r.suggested.forEach(s => add(s, 'sg'));
  }
}

async function watch(s){
  current = s.login; currentStream = s;
  $('#now').textContent = s.name;
  $('#title').textContent = s.title || '';
  $('#ext').href = 'https://twitch.tv/' + s.login;
  $('#ext').hidden = false;
  $('#ext').href = 'https://twitch.tv/' + s.login;
  $('#ext').hidden = false;
  document.querySelectorAll('.av').forEach(e => e.classList.toggle('on', e.dataset.login === s.login));

  const r = await fetch('/api/watch', {method:'POST', headers:{'Content-Type':'application/json'},
                                       body: JSON.stringify({channel: s.login, quality: $('#q').value})}).then(r => r.json());
  if(!r.ok){ $('#now').textContent = 'failed: ' + r.message; return; }

  const v = $('#v');
  if(hls){ hls.destroy(); hls = null; }

  // Firefox blocks autoplay with sound, so start muted and offer unmute.
  // Play only once the manifest is parsed: calling play() before hls.js has
  // attached its MediaSource cancels it, which showed up as a bogus AbortError.
  const start = async () => {
    v.muted = true;
    try { await v.play(); }
    catch(e){ if(e.name !== 'AbortError') $('#now').textContent = s.name + ' (press play)'; }
    $('#unmute').hidden = false;
  };

  if(window.Hls && Hls.isSupported()){
    hls = new Hls({liveSyncDurationCount:3, backBufferLength:30, maxBufferLength:20});
    hls.on(Hls.Events.ERROR, (_e, d) => {
      if(d.fatal) $('#now').textContent = 'player error: ' + d.type + ' / ' + d.details;
    });
    hls.on(Hls.Events.MANIFEST_PARSED, start);
    hls.loadSource('/hls/stream.m3u8');
    hls.attachMedia(v);
  } else {
    v.src = '/hls/stream.m3u8';   // native HLS (safari); firefox needs hls.js
    start();
  }
  $('#unmute').onclick = () => { v.muted = false; v.volume = 1; $('#unmute').hidden = true; };

  // 7TV emotes for this channel (global set + channel set), fetched via the
  // server so there is no CORS question and the result is cached per channel
  EMOTES = {};
  fetch('/api/emotes?uid=' + encodeURIComponent(s.id || ''))
    .then(r => r.json())
    .then(d => { EMOTES = d.emotes || {}; emoteEvents(d.set_id); })
    .catch(() => {});

  chat(s.login);
}

function emoteEvents(setId){
  // 7TV EventAPI - live emote set changes, so a mod adding or removing an
  // emote takes effect without a refetch. op 35 = subscribe, op 0 = dispatch.
  if(esock){ esock.onclose = null; esock.close(); esock = null; }
  if(!setId) return;
  const sid = setId;
  esock = new WebSocket('wss://events.7tv.io/v3');
  esock.onopen = () => esock.send(JSON.stringify({
    op: 35, d: {type: 'emote_set.update', condition: {object_id: sid}}
  }));
  esock.onmessage = ev => {
    let m; try { m = JSON.parse(ev.data); } catch(e){ return; }
    if(m.op !== 0 || !m.d || m.d.type !== 'emote_set.update') return;
    const b = m.d.body || {};
    for(const it of (b.pulled || [])){
      const n = (it.old_value || {}).name;
      if(n) delete EMOTES[n];
    }
    for(const it of (b.pushed || [])){
      const v = it.value || {};
      const host = (v.data || {}).host || {};
      if(v.name && host.url){
        const files = (host.files || []).map(f => f.name);
        const f = files.includes('2x.webp') ? '2x.webp' : (files[0] || '2x.webp');
        EMOTES[v.name] = 'https:' + host.url + '/' + f;
      }
    }
  };
  esock.onclose = () => { if(currentStream) setTimeout(() => emoteEvents(sid), 5000); };
}

function chat(channel){
  if(sock){ sock.onclose = null; sock.close(); }
  const msgs = $('#msgs'); msgs.innerHTML = '';
  sock = new WebSocket('wss://irc-ws.chat.twitch.tv:443');
  sock.onopen = () => {
    sock.send('CAP REQ :twitch.tv/tags');
    sock.send('NICK justinfan' + Math.floor(Math.random()*90000+10000));
    sock.send('JOIN #' + channel);
  };
  sock.onmessage = ev => {
    for(const line of ev.data.split('\r\n')){
      if(!line) continue;
      if(line.startsWith('PING')){ sock.send('PONG :tmi.twitch.tv'); continue; }
      const m = line.match(/^@([^ ]*) :([^!]+)![^ ]+ PRIVMSG #[^ ]+ :(.*)$/);
      if(!m) continue;
      const tags = Object.fromEntries(m[1].split(';').map(p => p.split('=')));
      add(tags['display-name'] || m[2], m[3], tags.color, tags.emotes);
    }
  };
  sock.onclose = () => { if(current === channel) setTimeout(() => chat(channel), 2000); };
}

function esc(s){ return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function render(chunk){
  if(!chunk) return '';
  // split on whitespace but keep it, so spacing survives the substitution
  return chunk.split(/(\s+)/).map(w => {
    const u = EMOTES[w];
    return u ? '<img src="' + u + '" alt="' + esc(w) + '" title="' + esc(w) + '">' : esc(w);
  }).join('');
}

function add(user, text, color, emotes){
  // emote tag indexes are code-point offsets, so work on an array of code points
  const cps = [...text];
  const marks = [];
  if(emotes){
    for(const part of emotes.split('/')){
      if(!part) continue;
      const [id, ranges] = part.split(':');
      for(const r of (ranges || '').split(',')){
        const [a, b] = r.split('-').map(Number);
        if(!isNaN(a)) marks.push({a, b, id});
      }
    }
  }
  marks.sort((x, y) => x.a - y.a);
  let out = '', i = 0;
  for(const mk of marks){
    out += render(cps.slice(i, mk.a).join(''));
    out += `<img src="https://static-cdn.jtvnw.net/emoticons/v2/${mk.id}/default/dark/1.0" alt="">`;
    i = mk.b + 1;
  }
  out += render(cps.slice(i).join(''));

  const msgs = $('#msgs');
  const stuck = msgs.scrollTop + msgs.clientHeight >= msgs.scrollHeight - 40;
  const d = document.createElement('div');
  d.innerHTML = `<span class=u style="color:${color || '#a970ff'}">${esc(user)}</span>: ${out}`;
  msgs.appendChild(d);
  while(msgs.children.length > 300) msgs.removeChild(msgs.firstChild);
  if(stuck) msgs.scrollTop = msgs.scrollHeight;
}

$('#q').onchange = () => { if(currentStream) watch(currentStream); };
$('#refresh').onclick = loadLive;
loadLive();
setInterval(() => { if(!document.hidden) loadLive(); }, 90000);
document.addEventListener('visibilitychange', () => { if(!document.hidden) loadLive(); });
</script></body></html>
"""


def main() -> None:
    if not shutil.which("streamlink"):
        die("streamlink not found")
    srv = Server(("127.0.0.1", PORT), Handler)

    def bye(*_):
        # shutdown() blocks until serve_forever() returns, so it must not run on
        # the thread that is inside serve_forever() - that deadlocks.
        threading.Thread(target=lambda: (STREAMER.stop(), srv.shutdown()), daemon=True).start()

    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGTERM, bye)
    print(f"twitch-web  ->  http://127.0.0.1:{PORT}   (ctrl-c to stop)")
    try:
        srv.serve_forever()
    finally:
        STREAMER.stop()


if __name__ == "__main__":
    main()
