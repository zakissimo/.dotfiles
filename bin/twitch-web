<script>
const $ = s => document.querySelector(s);
let sock = null, current = null, currentStream = null, hls = null, EMOTES = {}, esock = null;
let CHAT_OFFSET = 0;                 // manual nudge, seconds (covers streamlink's own buffer)
let MEASURED = 8000;                 // ms the video is behind wall clock, from EXT-X-PROGRAM-DATE-TIME
try { const v = localStorage.getItem('chatOffset'); if(v !== null) CHAT_OFFSET = +v; } catch(e){}
const CHAT_DELAY = () => Math.max(0, MEASURED + CHAT_OFFSET * 1000);

// hls.playingDate is the wall-clock time of the frame currently on screen, so
// the difference from now is exactly how far behind live the picture is.
setInterval(() => {
  const d = hls && hls.playingDate;
  if(d){
    MEASURED = Math.max(0, Date.now() - d.getTime());
    $('#lag').textContent = (MEASURED / 1000).toFixed(1) + 's';
  } else {
    $('#lag').textContent = '-';
  }
}, 1000);

function recents(){
  try { return JSON.parse(localStorage.getItem('recent') || '[]'); } catch(e){ return []; }
}
function pushRecent(s){
  try {
    const r = recents().filter(x => x.login !== s.login);
    r.unshift({login:s.login, name:s.name, avatar:s.avatar || '', id:s.id || ''});
    localStorage.setItem('recent', JSON.stringify(r.slice(0, 6)));
  } catch(e){}
}

function setViewers(n, started){
  const el = $('#viewers');
  el.textContent = (n == null) ? ''
    : ('\u25cf ' + (n || 0).toLocaleString() + (started ? '  ' + uptime(started) : ''));
}

function uptime(iso){
  if(!iso) return '';
  const m = Math.floor((Date.now() - new Date(iso)) / 60000);
  return (m >= 60 ? Math.floor(m/60)+'h '+(m%60)+'m' : m+'m');
}

let RAIL = {streams: [], suggested: [], recent_live: {}};
let lastLoad = 0;

async function loadLive(force){
  // the interval and the visibilitychange handler can fire together; one
  // refresh per ~15s is plenty for a sidebar
  if(!force && Date.now() - lastLoad < 15000) return;
  lastLoad = Date.now();
  const rec = recents();
  const qs = rec.length ? '?recent=' + encodeURIComponent(rec.map(x => x.login).join(',')) : '';
  const r = await fetch('/api/live' + qs).then(r => r.json()).catch(e => ({error:String(e)}));
  if(r.error){ $('#now').textContent = 'api: ' + r.error; return; }
  RAIL = r;
  renderRail();
}

// Pure render from RAIL + localStorage, so clicking a channel can reorder the
// recents row without five more Helix calls.
function renderRail(){
  const list = $('#list');
  const rec = recents();
  const r = RAIL;
  list.innerHTML = '';

  const addAvatar = (s, cls) => {
    const off = s.live === false;
    const el = document.createElement('div');
    el.className = 'av ' + cls + (off ? ' off' : '') + (s.login === current ? ' on' : '');
    el.dataset.login = s.login;
    // no labels in the rail, so the tooltip carries everything
    el.title = off ? (s.name + '\noffline')
             : (s.name + '\n' + (s.game || '-') + ' - ' + (s.viewers || 0).toLocaleString()
                + ' viewers - ' + uptime(s.started_at) + (s.title ? '\n' + s.title : ''));
    const img = document.createElement('img');
    img.src = s.avatar || ''; img.alt = s.name; img.loading = 'lazy';
    el.appendChild(img);
    el.onclick = () => off
      ? window.open('https://twitch.tv/' + s.login, '_blank', 'noopener')
      : watch(s);
    list.appendChild(el);
  };
  const sep = () => { const d = document.createElement('div'); d.className = 'sep'; list.appendChild(d); };

  // recently watched first, so flicking between two streams is one click
  const liveMap = r.recent_live || {};
  // deliberately NOT deduplicated against follows: most watched channels are
  // followed, and the point of this row is a fixed spot to click without
  // hunting through the follows list
  if(rec.length){
    rec.forEach(x => addAvatar(Object.assign({}, x, liveMap[x.login] || {},
                                             {live: !!liveMap[x.login]}), 'rc'));
    sep();
  }

  // keep the player bar's viewer count fresh for whatever is playing
  if(current){
    const cur = (r.streams || []).concat(r.suggested || []).find(x => x.login === current)
              || (liveMap[current] ? Object.assign({login:current}, liveMap[current]) : null);
    if(cur) setViewers(cur.viewers, cur.started_at);
  }

  (r.streams || []).forEach(s => addAvatar(s, 'fl'));
  if((r.suggested || []).length){
    sep();
    r.suggested.forEach(s => addAvatar(s, 'sg'));
  }
}

// One token for everything a channel switch owns: anything that comes back
// late (a fetch, a reconnect timer, a socket) checks it and bows out, instead
// of stomping on the channel you have since moved to.
let GEN = 0;

function teardownPlayer(){
  if(hls){ hls.destroy(); hls = null; }
  const v = $('#v');
  try { v.pause(); } catch(e){}
  v.removeAttribute('src');
  v.load();
}

async function watch(s){
  const gen = ++GEN;
  current = s.login; currentStream = s;
  pushRecent(s);
  renderRail();            // recents come from localStorage; no refetch needed
  $('#now').textContent = s.name;
  $('#title').textContent = s.title || '';
  $('#ext').href = 'https://twitch.tv/' + s.login;
  $('#ext').hidden = false;
  setViewers(s.viewers, s.started_at);
  document.querySelectorAll('.av').forEach(e => e.classList.toggle('on', e.dataset.login === s.login));

  // drop the old player before the await, so its error handler cannot report
  // "network error" against the stream the server has already torn down
  teardownPlayer();

  // chat and emotes do not depend on the video pipeline, so start them now
  // instead of after /api/watch returns - no reason to make chat wait ~2s
  EMOTES = {};
  fetch('/api/emotes?uid=' + encodeURIComponent(s.id || ''))
    .then(r => r.json())
    .then(d => { if(gen === GEN){ EMOTES = d.emotes || {}; emoteEvents(d.set_id, gen); } })
    .catch(() => {});
  chat(s.login, gen);

  let r;
  try {
    r = await fetch('/api/watch', {method:'POST', headers:{'Content-Type':'application/json'},
                                   body: JSON.stringify({channel: s.login, quality: $('#q').value})})
          .then(r => r.json());
  } catch(e){ r = {ok:false, message:String(e)}; }
  if(gen !== GEN) return;                       // a newer click won
  if(!r.ok){
    teardownPlayer();
    $('#now').textContent = 'failed: ' + (r.message || 'unknown');
    $('#title').textContent = ''; setViewers(null);
    return;
  }

  const v = $('#v');

  // Firefox blocks autoplay with sound, so start muted and offer unmute.
  // Play only once the manifest is parsed: calling play() before hls.js has
  // attached its MediaSource cancels it, which showed up as a bogus AbortError.
  const start = async () => {
    // Try with sound first. Firefox only allows that if autoplay is permitted
    // for this origin, so fall back to muted rather than not playing at all.
    v.muted = false; v.volume = 1;
    try {
      await v.play();
      $('#unmute').hidden = true;
      return;
    } catch(e){
      if(e.name === 'AbortError') return;   // hls.js attaching cancelled it
    }
    v.muted = true;
    try { await v.play(); }
    catch(e){ if(e.name !== 'AbortError') $('#now').textContent = s.name + ' (press play)'; }
    $('#unmute').hidden = false;
  };

  if(window.Hls && Hls.isSupported()){
    // 2 segments, not 3: Twitch's GOP is 2s and -c copy can only cut on
    // keyframes, so each segment is 2s. 3 meant a 6s wait before playback.
    hls = new Hls({liveSyncDurationCount:2, backBufferLength:30, maxBufferLength:20,
                   startPosition:-1});
    hls.on(Hls.Events.ERROR, (_e, d) => {
      if(d.fatal) $('#now').textContent = 'player error: ' + d.type + ' / ' + d.details;
    });
    hls.on(Hls.Events.MANIFEST_PARSED, start);
    hls.loadSource('/hls/stream.m3u8');
    hls.attachMedia(v);
  } else {
    v.src = '/hls/stream.m3u8';   // native HLS (safari); firefox needs hls.js
    start();
  }
  $('#unmute').onclick = () => { v.muted = false; v.volume = 1; $('#unmute').hidden = true; };

}

function emoteEvents(setId, gen){
  // 7TV EventAPI - live emote set changes, so a mod adding or removing an
  // emote takes effect without a refetch. op 35 = subscribe, op 0 = dispatch.
  if(esock){ esock.onclose = null; esock.close(); esock = null; }
  if(!setId) return;
  const sid = setId;
  esock = new WebSocket('wss://events.7tv.io/v3');
  esock.onopen = () => esock.send(JSON.stringify({
    op: 35, d: {type: 'emote_set.update', condition: {object_id: sid}}
  }));
  esock.onmessage = ev => {
    let m; try { m = JSON.parse(ev.data); } catch(e){ return; }
    if(m.op !== 0 || !m.d || m.d.type !== 'emote_set.update') return;
    const b = m.d.body || {};
    for(const it of (b.pulled || [])){
      const n = (it.old_value || {}).name;
      if(n) delete EMOTES[n];
    }
    for(const it of (b.pushed || [])){
      const v = it.value || {};
      const host = (v.data || {}).host || {};
      if(v.name && host.url){
        const files = (host.files || []).map(f => f.name);
        const f = files.includes('2x.webp') ? '2x.webp' : (files[0] || '2x.webp');
        EMOTES[v.name] = 'https:' + host.url + '/' + f;
      }
    }
  };
  esock.onclose = () => { if(gen === GEN) setTimeout(() => { if(gen === GEN) emoteEvents(sid, gen); }, 5000); };
}

const PENDING = new Map();   // msg-id -> {timeout, login} for messages still held back

function clearPending(){
  for(const p of PENDING.values()) clearTimeout(p.t);
  PENDING.clear();
}

function dropMsg(mid){
  if(!mid) return;
  const p = PENDING.get(mid);
  if(p){ clearTimeout(p.t); PENDING.delete(mid); }      // never shown at all
  const el = MSGS().querySelector('[data-mid="' + CSS.escape(mid) + '"]');
  if(el) el.remove();                                   // already on screen
}

function dropUser(login){
  if(!login) return;
  for(const [mid, p] of PENDING){
    if(p.login === login){ clearTimeout(p.t); PENDING.delete(mid); }
  }
  MSGS().querySelectorAll('[data-user="' + CSS.escape(login) + '"]').forEach(e => e.remove());
}

function chat(channel, gen){
  if(sock){ sock.onclose = null; sock.close(); }
  clearPending();
  const msgs = $('#msgs'); msgs.innerHTML = '';
  sock = new WebSocket('wss://irc-ws.chat.twitch.tv:443');
  sock.onopen = () => {
    sock.send('CAP REQ :twitch.tv/tags twitch.tv/commands');
    sock.send('NICK justinfan' + Math.floor(Math.random()*90000+10000));
    sock.send('JOIN #' + channel);
  };
  sock.onmessage = ev => {
    for(const line of ev.data.split('\r\n')){
      if(!line) continue;
      if(line.startsWith('PING')){ sock.send('PONG :tmi.twitch.tv'); continue; }
      // Tokenise properly. Matching command names anywhere in the line let a
      // chatter put "CLEARCHAT #x" in a message body and wipe or censor the pane.
      const p = line.match(/^(?:@(\S*) )?(?::(\S+) )?(\S+)(?: (.*))?$/);
      if(!p) continue;
      const tags = Object.fromEntries((p[1] || '').split(';').filter(Boolean).map(x => {
        const i = x.indexOf('='); return [x.slice(0, i), x.slice(i + 1)];
      }));
      const prefix = p[2] || '', cmd = p[3], rest = p[4] || '';

      if(cmd === 'CLEARMSG'){ dropMsg(tags['target-msg-id']); continue; }

      if(cmd === 'CLEARCHAT'){
        const sep = rest.indexOf(' :');
        const who = sep >= 0 ? rest.slice(sep + 2).trim() : '';
        if(who) dropUser(who);
        else { MSGS().innerHTML = ''; clearPending(); }
        continue;
      }

      if(cmd !== 'PRIVMSG') continue;
      const sep = rest.indexOf(' :');
      if(sep < 0) continue;
      const login = (prefix.split('!')[0] || '').toLowerCase();
      const m = [null, login, rest.slice(sep + 2)];
      const mid = tags.id || '';
      // The video runs several seconds behind live, so showing chat as it
      // arrives spoils reactions. Hold each line for the configured delay, and
      // drop it if the channel changed while it was waiting.
      const chan = gen;
      const args = [tags['display-name'] || login, m[2], tags.color, tags.emotes, mid, login];
      const wait = CHAT_DELAY();
      if(wait > 0){
        const t = setTimeout(() => {
          PENDING.delete(mid);
          if(chan === GEN) addMessage(...args);
        }, wait);
        if(mid) PENDING.set(mid, {t, login});
      } else {
        addMessage(...args);
      }
    }
  };
  sock.onclose = () => { if(gen === GEN) setTimeout(() => { if(gen === GEN) chat(channel, gen); }, 2000); };
}

const ESC = {'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'};
function esc(s){ return s.replace(/[&<>"']/g, c => ESC[c]); }
const MSGS = () => $('#msgs');

function emoteImg(url, name){
  const im = document.createElement('img');
  im.src = url; im.alt = name || ''; if(name) im.title = name;
  return im;
}

// Append a plain-text chunk to `frag`, swapping 7TV emote words for images.
// Built with DOM nodes rather than an HTML string: emote names and URLs are
// third-party data and must never be parsed as markup.
function render(chunk, frag){
  if(!chunk) return;
  for(const w of chunk.split(/(\s+)/)){
    if(!w) continue;
    const u = EMOTES[w];
    if(u) frag.appendChild(emoteImg(u, w));
    else frag.appendChild(document.createTextNode(w));
  }
}

function addMessage(user, text, color, emotes, mid, login){
  // emote tag indexes are code-point offsets, so work on an array of code points
  const cps = [...text];
  const marks = [];
  if(emotes){
    for(const part of emotes.split('/')){
      if(!part) continue;
      const [id, ranges] = part.split(':');
      for(const r of (ranges || '').split(',')){
        const [a, b] = r.split('-').map(Number);
        if(!isNaN(a)) marks.push({a, b, id});
      }
    }
  }
  marks.sort((x, y) => x.a - y.a);

  const body = document.createDocumentFragment();
  let i = 0;
  for(const mk of marks){
    // ignore malformed or overlapping ranges rather than garbling the line
    if(!(mk.a >= i && mk.b >= mk.a && mk.b < cps.length)) continue;
    render(cps.slice(i, mk.a).join(''), body);
    body.appendChild(emoteImg(
      'https://static-cdn.jtvnw.net/emoticons/v2/' +
      encodeURIComponent(mk.id) + '/default/dark/1.0', ''));
    i = mk.b + 1;
  }
  render(cps.slice(i).join(''), body);

  const msgs = MSGS();
  const stuck = msgs.scrollTop + msgs.clientHeight >= msgs.scrollHeight - 60;
  const d = document.createElement('div');
  if(mid) d.dataset.mid = mid;
  if(login) d.dataset.user = login;
  const nick = document.createElement('span');
  nick.className = 'u';
  // assigning .style.color cannot escape the attribute the way interpolation can
  nick.style.color = /^#[0-9a-fA-F]{3,8}$/.test(color || '') ? color : '#a970ff';
  nick.textContent = user;
  d.append(nick, document.createTextNode(': '), body);
  msgs.appendChild(d);
  while(msgs.children.length > 300) msgs.removeChild(msgs.firstChild);

  if(stuck){
    // Emote images have no known width until they load, so the line rewraps and
    // grows after we scroll. Pin now, again after layout, and once more as each
    // image resolves - otherwise chat drifts just above the bottom.
    const pin = () => { msgs.scrollTop = msgs.scrollHeight; };
    pin();
    requestAnimationFrame(pin);
    d.querySelectorAll('img').forEach(im => {
      if(im.complete) return;
      im.addEventListener('load', pin, {once:true});
      im.addEventListener('error', pin, {once:true});
    });
  }
}

$('#q').onchange = () => { if(currentStream) watch(currentStream); };
let sItems = [], sIdx = -1, sTimer = null;

function openSearch(){
  $('#search').hidden = false;
  $('#sin').value = ''; $('#sres').innerHTML = '';
  sItems = []; sIdx = -1;
  $('#sin').focus();
}
function closeSearch(){ $('#search').hidden = true; }

function renderSearch(){
  const box = $('#sres');
  box.innerHTML = '';
  sItems.forEach((it, i) => {
    const el = document.createElement('div');
    el.className = 'sr' + (it.live ? '' : ' off') + (i === sIdx ? ' sel' : '');
    const img = document.createElement('img');
    img.src = it.avatar || ''; img.alt = '';
    const mid = document.createElement('div');
    mid.innerHTML = '<b></b><div class=g></div>';
    mid.querySelector('b').textContent = it.name;
    mid.querySelector('.g').textContent = it.live ? (it.game || '-') : 'offline';
    const right = document.createElement('div');
    right.className = 'v';
    right.textContent = it.live ? ('* ' + it.viewers.toLocaleString()) : '';
    el.append(img, mid, right);
    el.onclick = () => pick(i);
    box.appendChild(el);
  });
  const sel = box.querySelector('.sel');
  if(sel) sel.scrollIntoView({block:'nearest'});
}

let sSeq = 0;
function moveSel(d){
  // just move the class; rebuilding all rows per keypress was wasteful
  const rows = $('#sres').children;
  if(!rows.length) return;
  if(rows[sIdx]) rows[sIdx].classList.remove('sel');
  sIdx = Math.max(0, Math.min(sIdx + d, rows.length - 1));
  rows[sIdx].classList.add('sel');
  rows[sIdx].scrollIntoView({block:'nearest'});
}

async function doSearch(){
  const t = $('#sin').value.trim();
  if(!t){ sItems = []; $('#sres').innerHTML = ''; return; }
  const seq = ++sSeq;
  const r = await fetch('/api/search?q=' + encodeURIComponent(t))
    .then(r => r.json()).catch(() => ({results: []}));
  if(seq !== sSeq) return;            // a later query already answered
  sItems = r.results || [];
  sIdx = sItems.findIndex(x => x.live);          // first live result
  if(sIdx < 0 && sItems.length) sIdx = 0;
  renderSearch();
}

function pick(i){
  const it = sItems[i];
  if(!it) return;
  closeSearch();
  if(it.live) watch(it);
  else window.open('https://twitch.tv/' + it.login, '_blank', 'noopener');
}

$('#find').onclick = () => { $('#search').hidden ? openSearch() : closeSearch(); };
document.addEventListener('pointerdown', e => {
  if($('#search').hidden) return;
  if($('#sbox').contains(e.target) || e.target.id === 'find') return;
  closeSearch();   // deliberately not preventDefault: the click still lands
});
$('#sin').oninput = () => { clearTimeout(sTimer); sTimer = setTimeout(doSearch, 250); };

document.addEventListener('keydown', e => {
  if(!$('#search').hidden){
    if(e.key === 'Escape'){ closeSearch(); }
    else if(e.key === 'ArrowDown'){ e.preventDefault(); moveSel(1); }
    else if(e.key === 'ArrowUp'){ e.preventDefault(); moveSel(-1); }
    else if(e.key === 'Enter'){ e.preventDefault(); pick(sIdx); }
    return;
  }
  const tag = (e.target.tagName || '').toLowerCase();
  if(tag === 'input' || tag === 'select' || tag === 'textarea') return;
  if(e.key === '/' || (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey))){
    e.preventDefault(); openSearch();
  }
});

$('#delay').value = CHAT_OFFSET;
$('#delay').onchange = () => {
  CHAT_OFFSET = +$('#delay').value || 0;
  try { localStorage.setItem('chatOffset', CHAT_OFFSET); } catch(e){}
};
// sendBeacon survives unload where fetch does not; without this, closing the
// tab leaves streamlink and ffmpeg pulling the stream indefinitely
addEventListener('pagehide', () => { try { navigator.sendBeacon('/api/stop'); } catch(e){} });

$('#refresh').onclick = () => loadLive(true);
loadLive(true);
setInterval(() => { if(!document.hidden) loadLive(true); }, 90000);
document.addEventListener('visibilitychange', () => { if(!document.hidden) loadLive(); });
</script></body></html>
"""


PAGE_BYTES = PAGE.encode()


def _watchdog() -> None:
    """Stop the pipeline when nothing is consuming it.

    The page sends /api/stop on unload, but that misses a crashed browser or a
    suspended machine - without this, streamlink and ffmpeg keep pulling the
    stream forever.
    """
    while True:
        time.sleep(5)
        with STREAMER.lock_snapshot():
            running = STREAMER.channel is not None
        idle = time.monotonic() - (STREAMER.last_seen or 0)
        if running and STREAMER.last_seen and idle > 30:
            print(f"  [watchdog] no HLS requests for {idle:.0f}s, stopping", file=sys.stderr)
            STREAMER.stop()


def main() -> None:
    for tool in ("streamlink", "ffmpeg"):
        if not shutil.which(tool):
            die(f"{tool} not found")
    srv = Server(("127.0.0.1", PORT), Handler)

    def bye(*_):
        # shutdown() blocks until serve_forever() returns, so it must not run on
        # the thread that is inside serve_forever() - that deadlocks.
        threading.Thread(target=lambda: (STREAMER.stop(), srv.shutdown()), daemon=True).start()

    threading.Thread(target=_watchdog, daemon=True).start()
    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGTERM, bye)
    print(f"twitch-web  ->  http://127.0.0.1:{PORT}   (ctrl-c to stop)")
    try:
        srv.serve_forever()
    finally:
        STREAMER.stop()


if __name__ == "__main__":
    main()
