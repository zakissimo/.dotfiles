#!/usr/bin/env python3
"""
twitch-web — a local web frontend for Twitch.

  * sidebar of the followed channels that are live (Helix)
  * ad-free video, because streamlink sits in the pipeline and filters
    `twitch-stitched-ad` segments before anything reaches the browser
  * chat over Twitch's IRC WebSocket (read-only, anonymous)

Reuses the credentials that `twitch` already set up:
  ~/.config/twitch/config          CLIENT_ID=...
  ~/.local/state/twitch/tokens.json access + refresh token

Run it, then open http://127.0.0.1:8777
"""

from __future__ import annotations

import http.server
import json
import collections
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request

CFG = os.path.expanduser("~/.config/twitch/config")
TOKENS = os.path.expanduser("~/.local/state/twitch/tokens.json")
UID_CACHE = os.path.expanduser("~/.local/state/twitch/user_id")

QUALITIES = {"best", "1080p60", "720p60", "720p", "480p", "360p", "160p", "worst", "audio_only"}
CHANNEL_RE = re.compile(r"[a-z0-9_]{1,25}")

PORT = int(os.environ.get("TWITCH_WEB_PORT", "8777"))
SL_PORT = int(os.environ.get("TWITCH_SL_PORT", "9100"))
SL_HOST = "127.0.0.1"


def die(msg: str) -> None:
    print(f"twitch-web: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------------- auth

class AuthError(RuntimeError):
    """Credentials missing or unusable. Raised, never die()d, from request threads."""


_CLIENT_ID: str | None = None
_TOKEN_LOCK = threading.Lock()
_TOKEN_CACHE: dict | None = None


def client_id() -> str:
    global _CLIENT_ID
    if _CLIENT_ID:
        return _CLIENT_ID
    try:
        with open(CFG) as fh:
            for line in fh:
                if line.startswith("CLIENT_ID="):
                    _CLIENT_ID = line.split("=", 1)[1].strip()
                    if _CLIENT_ID:
                        return _CLIENT_ID
    except FileNotFoundError:
        pass
    raise AuthError("no CLIENT_ID; run `twitch` once to set up credentials")


def _post(url: str, data: dict) -> dict:
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=body, method="POST")
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def _read_tokens() -> dict:
    with open(TOKENS) as fh:
        return json.load(fh)


def _write_tokens(out: dict) -> None:
    """Atomic: a crash mid-write must not leave a truncated token file."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(TOKENS), prefix=".tokens.")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(out, fh)
        os.chmod(tmp, 0o600)
        os.replace(tmp, TOKENS)
    except BaseException:
        os.unlink(tmp)
        raise


def access_token() -> str:
    """Current access token, refreshing if due.

    Serialised: refresh tokens are single-use, so two threads refreshing at once
    would invalidate each other and force an interactive re-login.
    """
    global _TOKEN_CACHE
    with _TOKEN_LOCK:
        tok = _TOKEN_CACHE
        if tok is None:
            try:
                tok = _read_tokens()
            except (FileNotFoundError, json.JSONDecodeError) as exc:
                raise AuthError("no tokens; run `twitch` once to authorize") from exc
        if time.time() < tok.get("expires_at", 0):
            _TOKEN_CACHE = tok
            return tok["access_token"]
        # re-read before refreshing: another process may have rotated it already
        try:
            disk = _read_tokens()
            if time.time() < disk.get("expires_at", 0):
                _TOKEN_CACHE = disk
                return disk["access_token"]
            tok = disk
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        new = _post("https://id.twitch.tv/oauth2/token", {
            "client_id": client_id(),
            "grant_type": "refresh_token",
            "refresh_token": tok["refresh_token"],
        })
        if "access_token" not in new:
            raise AuthError("token refresh failed; run `twitch` to re-authorize")
        out = {
            "access_token": new["access_token"],
            "refresh_token": new.get("refresh_token", tok["refresh_token"]),
            # int, not float: the bash `twitch` reads this with [ -lt ], which
            # errors on a decimal and then refreshes on every run
            "expires_at": int(time.time() + new.get("expires_in", 14400) - 60),
        }
        _write_tokens(out)
        _TOKEN_CACHE = out
        return out["access_token"]


def helix(path: str) -> dict:
    req = urllib.request.Request(
        f"https://api.twitch.tv/helix/{path}",
        headers={"Client-Id": client_id(), "Authorization": f"Bearer {access_token()}"},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def user_id() -> str:
    try:
        with open(UID_CACHE) as fh:
            uid = fh.read().strip()
            if uid:
                return uid
    except FileNotFoundError:
        pass
    uid = helix("users")["data"][0]["id"]
    with open(UID_CACHE, "w") as fh:
        fh.write(uid)
    return uid


# ------------------------------------------------------------------- streamlink

def _slim(s: dict, avatars: dict) -> dict:
    return {
        "id": s["user_id"],
        "login": s["user_login"],
        "name": s["user_name"],
        "game": s.get("game_name") or "",
        "title": s.get("title") or "",
        "viewers": s.get("viewer_count", 0),
        "started_at": s.get("started_at"),
        "avatar": avatars.get(s["user_id"], ""),
    }


def build_live(recent: list | None = None) -> dict:
    """Followed channels that are live, plus suggestions.

    Twitch's real recommendations live in the private GQL API, so "suggested"
    here means: top live channels in the games the follows are playing, minus
    anyone already followed.
    """
    followed = helix(f"streams/followed?user_id={user_id()}&first=100")["data"]
    followed.sort(key=lambda x: x.get("viewer_count", 0), reverse=True)
    mine = {x["user_login"] for x in followed}

    games, seen = [], set()
    for x in followed:
        g = x.get("game_id")
        if g and g not in seen:
            seen.add(g)
            games.append(g)

    try:
        if games:
            q = "&".join(f"game_id={g}" for g in games[:3])
            pool = helix(f"streams?{q}&first=60")["data"]
        else:
            pool = helix("streams?first=60")["data"]
    except Exception:  # noqa: BLE001 - suggestions are optional
        pool = []
    sugg, seen_login = [], set()
    for x in pool:
        lg = x["user_login"]
        if lg in mine or lg in seen_login:
            continue
        seen_login.add(lg)
        sugg.append(x)
        if len(sugg) >= 15:
            break

    # Profile images effectively never change, so only ask about ids we have not
    # seen. This was the bulk of the Helix traffic: ~115 users re-fetched on
    # every sidebar refresh, four times a minute.
    ids = [x["user_id"] for x in followed + sugg]
    with _AVATAR_LOCK:
        fresh = time.time() - _AVATARS_AT[0] < _AVATAR_TTL
        if not fresh:
            _AVATARS.clear()
            _AVATARS_AT[0] = time.time()
        missing = [i for i in ids if i not in _AVATARS]
    for i in range(0, len(missing), 100):
        batch = "&".join(f"id={x}" for x in missing[i:i + 100])
        try:
            got = helix(f"users?{batch}")["data"]
        except Exception:  # noqa: BLE001 - avatars are cosmetic
            continue
        with _AVATAR_LOCK:
            for u in got:
                _AVATARS[u["id"]] = (u.get("profile_image_url") or "").replace("300x300", "70x70")
    with _AVATAR_LOCK:
        avatars = {i: _AVATARS[i] for i in ids if i in _AVATARS}

    # which of the recently watched channels are live (the page keeps the
    # names/avatars itself, so only live state and metadata are needed here)
    recent_live: dict = {}
    if recent:
        try:
            qq = "&".join(f"user_login={urllib.parse.quote(x)}" for x in recent[:20])
            for st in helix(f"streams?{qq}")["data"]:
                recent_live[st["user_login"]] = {
                    "game": st.get("game_name") or "",
                    "title": st.get("title") or "",
                    "viewers": st.get("viewer_count", 0),
                    "started_at": st.get("started_at"),
                }
        except Exception:  # noqa: BLE001 - recents are a convenience
            pass

    return {
        "streams": [_slim(x, avatars) for x in followed],
        "suggested": [_slim(x, avatars) for x in sugg],
        "recent_live": recent_live,
    }


_AVATARS: dict[str, str] = {}
_AVATARS_AT = [0.0]
_AVATAR_TTL = 6 * 3600
_AVATAR_LOCK = threading.Lock()

_EMOTE_CACHE: dict[str, tuple[float, dict, str]] = {}
_EMOTE_TTL = 600  # seconds; a safety net - live changes arrive over the EventAPI


def _fetch_json(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": "twitch-web"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def _collect_bttv(items: list, out: dict) -> None:
    for e in items or []:
        code, eid = e.get("code"), e.get("id")
        if code and eid and str(eid).isalnum():
            out[code] = f"https://cdn.betterttv.net/emote/{eid}/2x"


def _collect_ffz(sets: dict, out: dict) -> None:
    for st in (sets or {}).values():
        for e in st.get("emoticons") or []:
            name = e.get("name")
            # prefer the animated variant when the emote has one
            urls = ((e.get("animated") or {}) or e.get("urls") or {}) or {}
            url = urls.get("2") or urls.get("4") or urls.get("1")
            if not (name and url):
                continue
            if url.startswith("//"):
                url = "https:" + url
            if not url.startswith("https://cdn.frankerfacez.com/"):
                continue
            out[name] = url


def _collect(emotes: list, out: dict) -> None:
    for e in emotes or []:
        name = e.get("name")
        host = ((e.get("data") or {}).get("host") or {})
        base = host.get("url") or ""
        if not name or not base:
            continue
        # host.url is protocol-relative, e.g. //cdn.7tv.app/emote/<id>
        if not base.startswith("//cdn.7tv.app/"):
            continue  # only ever build URLs for 7TV's own CDN
        files = {f.get("name") for f in (host.get("files") or [])}
        fname = next((n for n in ("2x.webp", "1x.webp") if n in files), None)
        if not fname:
            continue  # no usable size; emitting a known-absent name just 404s
        out[name] = f"https:{base}/{fname}"


def seventv_emotes(twitch_id: str) -> tuple[dict, str]:
    """({emote name -> image url}, emote_set_id) for 7TV global + channel set.

    The set id lets the page subscribe to 7TV's EventAPI, so a mod adding or
    removing an emote shows up live instead of waiting for the cache to expire.
    """
    hit = _EMOTE_CACHE.get(twitch_id)
    if hit and time.time() - hit[0] < _EMOTE_TTL:
        return hit[1], hit[2]
    out: dict = {}
    set_id = ""

    # Merged in precedence order, later wins: globals first, then this
    # channel's sets; within each tier FFZ < BTTV < 7TV. Channels commonly use
    # all three (catJAM is BTTV-only on many channels, pepeJAM is on 7TV).
    def _try(fn):
        try:
            fn()
        except Exception:  # noqa: BLE001 - emotes are cosmetic, never fatal
            pass

    _try(lambda: _collect_ffz(_fetch_json("https://api.frankerfacez.com/v1/set/global").get("sets", {}), out))
    _try(lambda: _collect_bttv(_fetch_json("https://api.betterttv.net/3/cached/emotes/global"), out))
    _try(lambda: _collect(_fetch_json("https://7tv.io/v3/emote-sets/global").get("emotes", []), out))

    _try(lambda: _collect_ffz(
        _fetch_json(f"https://api.frankerfacez.com/v1/room/id/{twitch_id}").get("sets", {}), out))

    def _bttv_channel():
        d = _fetch_json(f"https://api.betterttv.net/3/cached/users/twitch/{twitch_id}")
        _collect_bttv((d.get("channelEmotes") or []) + (d.get("sharedEmotes") or []), out)
    _try(_bttv_channel)

    def _seventv_channel():
        nonlocal set_id
        user = _fetch_json(f"https://7tv.io/v3/users/twitch/{twitch_id}")
        eset = user.get("emote_set") or {}
        set_id = eset.get("id") or ""
        _collect(eset.get("emotes") or [], out)
    _try(_seventv_channel)
    if len(_EMOTE_CACHE) > 200:          # keep it from growing without bound
        for k in [k for k, v in _EMOTE_CACHE.items() if time.time() - v[0] > _EMOTE_TTL][:100]:
            _EMOTE_CACHE.pop(k, None)
    _EMOTE_CACHE[twitch_id] = (time.time(), out, set_id)
    return out, set_id


class Streamer:
    """Owns at most one streamlink process serving the current channel over HTTP."""

    def __init__(self) -> None:
        self.proc: subprocess.Popen | None = None       # streamlink
        self.ff: subprocess.Popen | None = None         # ffmpeg -> HLS
        self.hls_dir: str | None = None
        self.channel: str | None = None
        self.quality: str | None = None
        self.sl_err: collections.deque = collections.deque(maxlen=50)
        self.lock = threading.Lock()        # serialises start/stop; held for seconds
        self.state = threading.Lock()       # guards the fields above; held for microseconds
        self.last_seen = 0.0                # monotonic time of the last /hls/ request

    def lock_snapshot(self):
        """Short lock for reading state. Never the big one: start() holds that
        across process spawning, and segment requests must not queue behind it."""
        return self.state

    def _drain(self, proc: subprocess.Popen) -> None:
        """Keep streamlink's stderr pipe empty.

        Nothing read it before, so once it filled the 64 KiB pipe buffer
        streamlink would block on its next write and the stream would stall
        silently. Kept in a bounded deque so startup errors are still reportable.
        """
        try:
            for line in proc.stderr:
                self.sl_err.append(line.rstrip())
        except (ValueError, OSError):
            pass

    def _port_open(self) -> bool:
        with socket.socket() as s:
            s.settimeout(0.3)
            return s.connect_ex((SL_HOST, SL_PORT)) == 0

    def stop(self) -> None:
        with self.lock:
            self._stop_locked()

    def _stop_locked(self) -> None:
        if self.ff and self.ff.poll() is None:
            # SIGKILL, not SIGTERM: ffmpeg blocks on the read from streamlink and
            # ignores SIGTERM until that returns, so a graceful stop burned the
            # full 5s timeout on every channel switch. The HLS output is deleted
            # below anyway, so there is nothing worth shutting down cleanly.
            self.ff.kill()
            try:
                self.ff.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
        self.ff = None
        if self.hls_dir:
            d, _ = self.hls_dir, None
            with self.state:
                self.hls_dir = None
            shutil.rmtree(d, ignore_errors=True)
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait(timeout=2)
        self.proc = None
        with self.state:
            self.channel = None
            self.quality = None
        # the port lingers briefly after the process dies
        for _ in range(20):
            if not self._port_open():
                break
            time.sleep(0.1)

    def start(self, channel: str, quality: str = "best") -> tuple[bool, str]:
        with self.lock:
            if (self.channel == channel and self.quality == quality
                    and self.proc and self.proc.poll() is None
                    and self.ff and self.ff.poll() is None):
                return True, "already running"
            t0 = time.time()
            self._stop_locked()
            t_stop = time.time() - t0
            cmd = [
                "streamlink",
                "--player-external-http",
                "--player-external-http-interface", SL_HOST,
                "--player-external-http-port", str(SL_PORT),
                "--player-external-http-continuous", "yes",
                f"twitch.tv/{channel}", quality,
            ]
            # --twitch-low-latency trims the HLS live edge to 2 segments. That is
            # great for latency and bad for smoothness in a browser, where MSE has
            # no slack to absorb a hiccup. Opt in with TWITCH_LOW_LATENCY=1.
            if os.environ.get("TWITCH_LOW_LATENCY") == "1":
                cmd.insert(-2, "--twitch-low-latency")
            self.sl_err.clear()
            self.proc = subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
            )
            threading.Thread(target=self._drain, args=(self.proc,), daemon=True).start()
            with self.state:
                self.channel = channel
                self.quality = quality
            # wait for the HTTP server to come up (resolving the stream takes a moment)
            for _ in range(300):
                if self.proc.poll() is not None:
                    time.sleep(0.1)                     # let the drain thread catch up
                    err = list(self.sl_err)
                    self._stop_locked()
                    return False, err[-1] if err else "streamlink exited"
                if self._port_open():
                    t_sl = time.time() - t0
                    ok, msg = self._start_hls()
                    print(f"  [switch] stop {t_stop:.1f}s  streamlink {t_sl - t_stop:.1f}s"
                          f"  hls {time.time() - t0 - t_sl:.1f}s  total {time.time() - t0:.1f}s",
                          file=sys.stderr)
                    return ok, msg
                time.sleep(0.05)
            self._stop_locked()
            return False, "timed out waiting for streamlink"

    def _start_hls(self) -> tuple[bool, str]:
        """Remux the TS into HLS with fMP4 segments.

        hls.js then handles live playback - live edge, buffering, recovery -
        and because the segments are already fMP4 it feeds MSE directly with no
        JavaScript transmuxing, which is what produced macroblocking before.
        """
        hls_dir = tempfile.mkdtemp(prefix="twitch-web-")
        with self.state:
            self.hls_dir = hls_dir
        m3u8 = os.path.join(hls_dir, "stream.m3u8")
        cmd = [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-fflags", "+genpts", "-i", f"http://{SL_HOST}:{SL_PORT}/",
            "-c", "copy",
            # TS carries AAC in ADTS framing; MP4/fMP4 needs raw AAC (ASC headers)
            "-bsf:a", "aac_adtstoasc",
            "-f", "hls",
            "-hls_time", "2",
            "-hls_list_size", "6",
            # program_date_time stamps each segment with wall-clock time, which lets
            # the page measure how far behind live the playing frame is
            "-hls_flags", "delete_segments+independent_segments+omit_endlist+program_date_time",
            "-hls_segment_type", "fmp4",
            "-hls_fmp4_init_filename", "init.mp4",
            "-hls_segment_filename", os.path.join(hls_dir, "seg%05d.m4s"),
            m3u8,
        ]
        with open("/tmp/twitch-web-ffmpeg.log", "ab", buffering=0) as errlog:
            self.ff = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=errlog)
        # wait for the playlist to list at least one segment
        for _ in range(400):
            if self.ff.poll() is not None:
                self._stop_locked()
                return False, "ffmpeg exited (see /tmp/twitch-web-ffmpeg.log)"
            try:
                if ".m4s" in open(m3u8).read():
                    return True, "ok"
            except OSError:
                pass
            time.sleep(0.05)
        self._stop_locked()
        return False, "timed out waiting for HLS segments"


STREAMER = Streamer()


# ------------------------------------------------------------------------ server

class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "twitch-web"

    def log_message(self, fmt, *args):  # quieter console, with timing
        msg = fmt % args
        if "/hls/" in msg and " 200 " in msg:
            return                      # segment polling drowns out everything else
        sys.stderr.write("  %.2f  %s\n" % (time.time() % 100, msg))

    # -- helpers
    def _same_origin(self) -> bool:
        """A loopback server is reachable from every page the browser has open.

        Require the Host to be our own (blocks DNS rebinding) and any Origin that
        is sent to match it (blocks cross-origin POSTs, which need no preflight
        when the body is text/plain).
        """
        allowed = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
        if (self.headers.get("Host") or "") not in allowed:
            return False
        origin = self.headers.get("Origin")
        if origin and urllib.parse.urlparse(origin).netloc not in allowed:
            return False
        return True

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _html(self, body: bytes):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    # -- routes
    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(url.query)

        if url.path == "/":
            return self._html(PAGE_BYTES)

        if url.path.startswith("/api/") and not self._same_origin():
            return self._json({"error": "bad origin"}, 403)

        if url.path == "/api/live":
            try:
                rec = [x for x in (q.get("recent") or [""])[0].split(",") if x]
                payload = build_live(rec)
            except AuthError as exc:
                return self._json({"error": str(exc)}, 401)
            except Exception as exc:  # noqa: BLE001 - surface it in the UI
                return self._json({"error": str(exc)}, 500)
            return self._json(payload)

        if url.path == "/api/search":
            term = (q.get("q") or [""])[0].strip()
            if not term:
                return self._json({"results": []})
            try:
                found = helix("search/channels?query="
                              + urllib.parse.quote(term) + "&first=12")["data"]
            except Exception as exc:  # noqa: BLE001
                return self._json({"error": str(exc)}, 500)
            # search/channels has no viewer count, so fetch it for the live ones
            live_ids = [d["id"] for d in found if d.get("is_live")]
            counts: dict = {}
            if live_ids:
                try:
                    qq = "&".join(f"user_id={i}" for i in live_ids)
                    for st in helix(f"streams?{qq}")["data"]:
                        counts[st["user_id"]] = st.get("viewer_count", 0)
                except Exception:  # noqa: BLE001 - counts are cosmetic
                    pass
            return self._json({"results": [
                {
                    "id": d["id"],
                    "login": d["broadcaster_login"],
                    "name": d["display_name"],
                    "game": d.get("game_name") or "",
                    "title": d.get("title") or "",
                    "live": bool(d.get("is_live")),
                    "viewers": counts.get(d["id"], 0),
                    "started_at": d.get("started_at"),
                    "avatar": (d.get("thumbnail_url") or "").replace("300x300", "70x70"),
                }
                for d in found
            ]})

        if url.path == "/api/emotes":
            uid = (q.get("uid") or [""])[0]
            if not uid.isdigit():          # twitch user ids are numeric
                return self._json({"emotes": {}, "set_id": ""})
            emotes, set_id = seventv_emotes(uid)
            return self._json({"emotes": emotes, "set_id": set_id})

        if url.path == "/api/status":
            with STREAMER.lock_snapshot():
                ch = STREAMER.channel
            return self._json({"channel": ch})

        if url.path.startswith("/hls/"):
            return self._serve_hls(os.path.basename(url.path))

        self.send_error(404)

    def do_POST(self):
        url = urllib.parse.urlparse(self.path)
        if not self._same_origin():
            return self._json({"error": "bad origin"}, 403)

        if url.path == "/api/stop":
            STREAMER.stop()
            return self._json({"ok": True})

        if url.path == "/api/watch":
            try:
                length = int(self.headers.get("Content-Length") or 0)
                payload = json.loads(self.rfile.read(length) or b"{}")
                channel = (payload.get("channel") or "").strip().lower()
                quality = (payload.get("quality") or "best").strip()
                # both end up in streamlink's argv, where any `--opt=value` token
                # would be honoured, so neither may be free-form
                if not CHANNEL_RE.fullmatch(channel):
                    return self._json({"error": "bad channel"}, 400)
                if quality not in QUALITIES:
                    return self._json({"error": "bad quality"}, 400)
                ok, msg = STREAMER.start(channel, quality)
            except AuthError as exc:
                return self._json({"error": str(exc)}, 401)
            except Exception as exc:  # noqa: BLE001 - never drop the connection
                return self._json({"error": str(exc)}, 500)
            return self._json({"ok": ok, "message": msg, "channel": channel if ok else None},
                              200 if ok else 500)
        self.send_error(404)

    def _serve_hls(self, name: str):
        """Serve ffmpeg's HLS output (playlist, init segment, media segments)."""
        with STREAMER.lock_snapshot():
            d = STREAMER.hls_dir
        if not d:
            return self.send_error(503, "nothing playing")
        STREAMER.last_seen = time.monotonic()
        path = os.path.join(d, name)
        if not os.path.isfile(path):
            return self.send_error(404)
        ctype = ("application/vnd.apple.mpegurl" if name.endswith(".m3u8")
                 else "video/iso.segment" if name.endswith(".m4s")
                 else "video/mp4")
        try:
            with open(path, "rb") as fh:
                body = fh.read()
        except OSError:
            return self.send_error(404)
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


