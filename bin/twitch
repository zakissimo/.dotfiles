#!/usr/bin/env bash
# twitch — watch a stream in mpv with Chatterino chat alongside.
#
#   twitch              pick from the followed channels that are live
#   twitch <channel>    go straight to a channel
#
# Quitting mpv drops back to the picker instead of exiting, so switching
# channels is just `q` then pick again. Chatterino is never restarted on a
# switch — `chatterino -a` activates the tab in the running instance.
#
# The picker needs a Twitch API token; first use walks through a one-time
# device-code login. Passing a channel name directly never requires auth.

set -uo pipefail

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/twitch"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/twitch"
CONF="$CFG_DIR/config"
TOKENS="$STATE_DIR/tokens.json"
SCOPES="user:read:follows"
CHATTERINO="com.chatterino.chatterino"
STARTED_CHAT=0

mkdir -p "$CFG_DIR" "$STATE_DIR"

die()  { printf 'twitch: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }
for d in curl jq fzf streamlink mpv flatpak; do need "$d"; done

# ---------- one-time client id ----------
ensure_client_id() {
  # read, never source: $CONF holds a value pasted at an interactive prompt
  [ -f "$CONF" ] && CLIENT_ID=$(sed -n 's/^CLIENT_ID=//p' "$CONF" | head -1)
  [ -n "${CLIENT_ID:-}" ] && return 0
  cat >&2 <<'MSG'

The channel picker needs a Twitch application Client ID (free, one minute):

  1. https://dev.twitch.tv/console/apps  ->  "Register Your Application"
  2. Name:         anything
     Redirect URL: https://localhost
                   (must be https; it is never used by the device-code flow
                    below, but the form requires a value)
     Category:     Application Integration
     Client Type:  Public      <-- important: a public client needs no secret
  3. Copy the Client ID below.

MSG
  if { exec 3</dev/tty; } 2>/dev/null; then
    read -rp "Client ID: " CLIENT_ID <&3 || true
    exec 3<&-
  else
    read -rp "Client ID: " CLIENT_ID || true
  fi
  [ -n "${CLIENT_ID:-}" ] || die "no client id given"
  case "$CLIENT_ID" in
    *[!a-zA-Z0-9]*) die "that does not look like a Client ID" ;;
  esac
  printf 'CLIENT_ID=%s\n' "$CLIENT_ID" >"$CONF"
  chmod 600 "$CONF"
}

save_tokens() {
  # `>"$TOKENS"` truncates before jq runs, so a non-JSON response (captive
  # portal, HTML error page) would wipe working tokens. Write via a temp file.
  local tmp
  tmp=$(mktemp "$STATE_DIR/.tokens.XXXXXX") || die "mktemp failed"
  if jq --argjson now "$(date +%s)" \
       '{access_token, refresh_token, expires_at: ($now + ((.expires_in // 14400) - 60))}' \
       >"$tmp" <<<"$1" && [ -s "$tmp" ]; then
    chmod 600 "$tmp"
    mv -f "$tmp" "$TOKENS"
  else
    rm -f "$tmp"
    die "unexpected token response: $1"
  fi
}

device_login() {
  local d dc code uri interval resp waited=0
  d=$(curl -sS -X POST https://id.twitch.tv/oauth2/device \
        -d "client_id=$CLIENT_ID" --data-urlencode "scopes=$SCOPES")
  dc=$(jq -r '.device_code // empty' <<<"$d")
  [ -n "$dc" ] || die "device authorization failed: $d"
  code=$(jq -r '.user_code' <<<"$d")
  uri=$(jq -r '.verification_uri' <<<"$d")
  interval=$(jq -r '.interval // 5' <<<"$d")
  printf '\n  Open : %s\n  Code : %s\n\n  waiting' "$uri" "$code" >&2
  while [ "$waited" -lt 600 ]; do
    sleep "$interval"; waited=$((waited + interval))
    resp=$(curl -sS -X POST https://id.twitch.tv/oauth2/token \
             -d "client_id=$CLIENT_ID" -d "device_code=$dc" \
             -d "grant_type=urn:ietf:params:oauth:grant-type:device_code")
    if jq -e '.access_token' >/dev/null 2>&1 <<<"$resp"; then
      save_tokens "$resp"; printf ' ok\n\n' >&2; return 0
    fi
    case "$(jq -r '.message // empty' <<<"$resp")" in
      *authorization_pending*|"") printf '.' >&2 ;;
      *) printf '\n' >&2; die "authorization failed: $(jq -r '.message' <<<"$resp")" ;;
    esac
  done
  die "timed out waiting for authorization"
}

refresh_tokens() {
  local rt resp
  rt=$(jq -r '.refresh_token // empty' "$TOKENS" 2>/dev/null) || return 1
  [ -n "$rt" ] || return 1
  resp=$(curl -sS -X POST https://id.twitch.tv/oauth2/token \
           -d "client_id=$CLIENT_ID" -d "grant_type=refresh_token" \
           --data-urlencode "refresh_token=$rt")
  jq -e '.access_token' >/dev/null 2>&1 <<<"$resp" || return 1
  save_tokens "$resp"
}

access_token() {
  local exp
  # strip any fractional part: [ -lt ] errors on a decimal, which silently
  # forced a refresh on every run and burned a single-use refresh token
  exp=$(jq -r '(.expires_at // 0) | floor' "$TOKENS" 2>/dev/null || echo 0)
  if [ -f "$TOKENS" ] && [ "$(date +%s)" -lt "${exp:-0}" ]; then
    jq -r '.access_token' "$TOKENS"; return 0
  fi
  refresh_tokens || device_login
  jq -r '.access_token' "$TOKENS"
}

api() { # api <path-with-query>
  local tok resp
  tok=$(access_token) || return 1
  resp=$(curl -sS -H "Client-Id: $CLIENT_ID" -H "Authorization: Bearer $tok" \
              "https://api.twitch.tv/helix/$1") || return 1
  # without this a 401 yields no .data and reads as "nobody you follow is live"
  if ! jq -e 'has("data")' >/dev/null 2>&1 <<<"$resp"; then
    printf 'twitch: API error: %s\n' "$(jq -r '.message // .' <<<"$resp" 2>/dev/null)" >&2
    return 1
  fi
  printf '%s' "$resp"
}

user_id() {
  local id resp
  id=$(cat "$STATE_DIR/user_id" 2>/dev/null) && [ -n "$id" ] && { printf '%s' "$id"; return 0; }
  resp=$(api users) || return 1
  id=$(jq -r '.data[0].id // empty' <<<"$resp")
  # return non-zero rather than die: this runs inside $( ), where exit would
  # only kill the subshell and the caller would see an empty string
  [ -n "$id" ] || return 1
  printf '%s' "$id" >"$STATE_DIR/user_id"
  printf '%s' "$id"
}

pick() {
  local rows uid resp
  ensure_client_id
  uid=$(user_id) || { printf 'twitch: could not resolve your user id (token valid?)\n' >&2; return 1; }
  resp=$(api "streams/followed?user_id=$uid&first=100") || return 1
  rows=$(jq -r '.data[]? | [.user_login, (.viewer_count|tostring), .game_name, .title] | @tsv' <<<"$resp")
  [ -n "$rows" ] || { printf 'twitch: nobody you follow is live.\n' >&2; return 1; }
  printf '%s\n' "$rows" \
    | sort -t$'\t' -k2 -nr \
    | awk -F'\t' '{printf "%-20s %6s  %-20.20s  %.70s\n", $1, $2, $3, $4}' \
    | fzf --prompt='twitch > ' --height=45% --reverse --no-multi \
          --header='enter: watch   esc: quit' \
    | awk '{print $1}'
}

chat_open() {
  local ch="$1"
  if pgrep -f -- "^flatpak run .*com\.chatterino\.chatterino" >/dev/null 2>&1; then
    flatpak run "$CHATTERINO" -a "t:$ch" >/dev/null 2>&1 &
  else
    flatpak run "$CHATTERINO" -c "t:$ch" >/tmp/chatterino.log 2>&1 &
    STARTED_CHAT=1
  fi
}

watch() {
  local ch="$1"
  chat_open "$ch"
  streamlink --player mpv "twitch.tv/$ch" best
}

cleanup() {
  [ "$STARTED_CHAT" = 1 ] && flatpak kill "$CHATTERINO" 2>/dev/null
  return 0
}
trap cleanup EXIT

main() {
  local ch="${1:-}"
  [ -n "$ch" ] && watch "$ch"
  while ch=$(pick); do
    [ -n "$ch" ] || break
    watch "$ch"
  done
}

main "$@"
