include "env.kdl"
include "input.kdl"
include "layout.kdl"
include "binds.kdl"

include "dms/cursor.kdl"
include "dms/outputs.kdl"

include "host.kdl"

spawn-at-startup "xhost" "+SI:localuser:root"
spawn-at-startup "dms" "run" "--session"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

animations {
}

window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    draw-border-with-background false
    variable-refresh-rate false
}

window-rule {
    match app-id="(?i)wine"
    match app-id="\\.exe$"
    match title="^Settings$"
    open-floating true
}

// Battle.net desktop app → floating. It shares app-id "steam_app_default" with
// World of Warcraft itself (both run from the same umu prefix), so the title is
// what separates them — matching app-id alone would float the game too.
window-rule {
    match app-id="^steam_app_default$" title="^Battle\\.net"
    open-floating true
}

window-rule {
    match app-id="sierrachart_64.exe" title="^Sierra Chart "
    default-column-width { proportion 1.0; }
    open-floating false
}

window-rule {
    match app-id="sierrachart_64.exe" title=" Log$"
    default-column-width { proportion 0.3; }
    open-floating false
}

window-rule {
    match app-id="sierrachart_64.exe" title="^Sierra Chart.*Login$"
    open-floating true
}

window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.5; }
}

// Transient Qt apps (image viewers, archives, system tools) → floating
window-rule {
    match app-id="^org\\.kde\\.gwenview$"
    match app-id="^org\\.kde\\.ark$"
    match app-id="^org\\.kde\\.partitionmanager$"
    match app-id="^qt6ct$"
    match app-id="^kvantummanager$"
    open-floating true
}

// Firefox popups/dialogs → floating; main browser windows stay tiled.
// Main window titles end with "— Mozilla Firefox"; popups don't.
window-rule {
    match app-id="^firefox$"
    exclude title="Mozilla Firefox$"
    open-floating true
}
